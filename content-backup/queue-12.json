v"}, "innerBlocks": [{"name": "core/paragraph", "attributes": {"content": "Sí. No necesitas cuenta, correo ni ningún dato personal para usarla."}, "innerBlocks": []}]}]}]}]}, {"name": "kadence/rowlayout", "attributes": {"columns": 1, "colLayout": "equal", "htmlTag": "section", "align": "full", "blockAlignment": "full", "inheritMaxWidth": true, "bgColor": "palette8", "bgColorClass": "palette8", "padding": [28, 24, 36, 24], "mobilePadding": [20, 16, 28, 16], "paddingUnit": "px", "verticalAlignment": "top", "className": "imc-section"}, "innerBlocks": [{"name": "kadence/column", "attributes": {"borderWidth": ["", "", "", ""]}, "innerBlocks": [{"name": "kadence/advancedheading", "attributes": {"content": "¿Buscas algo más específico?", "level": 2, "htmlTag": "h2", "align": "left", "color": "#1A2421", "typography": "Space Grotesk", "googleFont": true, "loadGoogleFont": true, "fontWeight": "600", "fontStyle": "normal", "fontSize": [32, 28, 26], "fontHeight": [1.15, 1.2, 1.25], "fontHeightType": "", "margin": [0, 0, 12, 0], "marginType": "px"}, "innerBlocks": []}]}]}, {"name": "kadence/rowlayout", "attributes": {"columns": 3, "colLayout": "equal", "htmlTag": "div", "align": "wide", "blockAlignment": "wide", "inheritMaxWidth": true, "padding": [8, 0, 8, 0], "paddingUnit": "px", "columnGutter": "custom", "customGutter": [20, "", ""], "gutterType": "px", "verticalAlignment": "top", "className": "imc-tools"}, "innerBlocks": [{"name": "kadence/column", "attributes": {"borderWidth": ["", "", "", ""]}, "innerBlocks": [{"name": "core/paragraph", "attributes": {"content": "<strong>Calculadora de IMC infantil</strong><br>Para niños y adolescentes de 2 a 19 años, con percentiles según la OMS y los CDC."}, "innerBlocks": []}, {"name": "kadence/advancedbtn", "attributes": {"hAlign": "left"}, "innerBlocks": [{"name": "kadence/singlebtn", "attributes": {"text": "Ver calculadora infantil", "link": "/imc-ninos/", "sizePreset": "medium", "padding": [14, 22, 14, 22], "paddingUnit": "px", "borderRadius": [6, 6, 6, 6], "borderRadiusUnit": "px", "color": "#0E5C52", "background": "#FFFFFF", "colorHover": "#FFFFFF", "backgroundHover": "#0E5C52", "borderStyle": [{"top": ["1", "solid", "#0E5C52"], "right": ["1", "solid", "#0E5C52"], "bottom": ["1", "solid", "#0E5C52"], "left": ["1", "solid", "#0E5C52"], "unit": "px"}]}, "innerBlocks": []}]}]}, {"name": "kadence/column", "attributes": {"borderWidth": ["", "", "", ""]}, "innerBlocks": [{"name": "core/paragraph", "attributes": {"content": "<strong>Calculadora de peso ideal</strong><br>Cuánto deberías pesar según tu estatura, sin necesidad de saber tu peso actual."}, "innerBlocks": []}, {"name": "kadence/advancedbtn", "attributes": {"hAlign": "left"}, "innerBlocks": [{"name": "kadence/singlebtn", "attributes": {"text": "Calcular peso ideal", "link": "/peso-ideal/", "sizePreset": "medium", "padding": [14, 22, 14, 22], "paddingUnit": "px", "borderRadius": [6, 6, 6, 6], "borderRadiusUnit": "px", "color": "#0E5C52", "background": "#FFFFFF", "colorHover": "#FFFFFF", "backgroundHover": "#0E5C52", "borderStyle": [{"top": ["1", "solid", "#0E5C52"], "right": ["1", "solid", "#0E5C52"], "bottom": ["1", "solid", "#0E5C52"], "left": ["1", "solid", "#0E5C52"], "unit": "px"}]}, "innerBlocks": []}]}]}, {"name": "kadence/column", "attributes": {"borderWidth": ["", "", "", ""]}, "innerBlocks": [{"name": "core/paragraph", "attributes": {"content": "<strong>IMC durante el embarazo</strong><br>Por qué el cálculo estándar de IMC no aplica durante el embarazo, y cuánto peso es recomendable ganar según cada trimestre."}, "innerBlocks": []}, {"name": "kadence/advancedbtn", "attributes": {"hAlign": "left"}, "innerBlocks": [{"name": "kadence/singlebtn", "attributes": {"text": "Ver IMC en el embarazo", "link": "/imc-embarazo/", "sizePreset": "medium", "padding": [14, 22, 14, 22], "paddingUnit": "px", "borderRadius": [6, 6, 6, 6], "borderRadiusUnit": "px", "color": "#0E5C52", "background": "#FFFFFF", "colorHover": "#FFFFFF", "backgroundHover": "#0E5C52", "borderStyle": [{"top": ["1", "solid", "#0E5C52"], "right": ["1", "solid", "#0E5C52"], "bottom": ["1", "solid", "#0E5C52"], "left": ["1", "solid", "#0E5C52"], "unit": "px"}]}, "innerBlocks": []}]}]}]}, {"name": "kadence/rowlayout", "attributes": {"columns": 1, "colLayout": "equal", "htmlTag": "section", "align": "full", "blockAlignment": "full", "inheritMaxWidth": true, "bgColor": "palette9", "bgColorClass": "palette9", "padding": [28, 24, 36, 24], "mobilePadding": [20, 16, 28, 16], "paddingUnit": "px", "verticalAlignment": "top", "className": "imc-section"}, "innerBlocks": [{"name": "kadence/column", "attributes": {"borderWidth": ["", "", "", ""]}, "innerBlocks": [{"name": "kadence/advancedheading", "attributes": {"content": "Confianza y metodología", "level": 2, "htmlTag": "h2", "align": "left", "color": "#1A2421", "typography": "Space Grotesk", "googleFont": true, "loadGoogleFont": true, "fontWeight": "600", "fontStyle": "normal", "fontSize": [32, 28, 26], "fontHeight": [1.15, 1.2, 1.25], "fontHeightType": "", "margin": [0, 0, 12, 0], "marginType": "px"}, "innerBlocks": []}, {"name": "core/paragraph", "attributes": {"content": "En IMC Calculadora seguimos la metodología descrita en nuestra <a href=\"/metodologia/\">página de metodología</a>. Fuentes: Organización Mundial de la Salud (OMS), Centros para el Control y Prevención de Enfermedades de Estados Unidos (CDC), Secretaría de Salud de México (NOM-008-SSA3-2017), IMSS."}, "innerBlocks": []}, {"name": "core/paragraph", "attributes": {"content": "Cada cifra de esta página se verifica contra la fuente citada arriba antes de publicarse. Ver <a href=\"/metodologia/\">metodología</a> para el detalle de cada fuente y <a href=\"/sobre-nosotros/\">sobre nosotros</a> para nuestro proceso de verificación."}, "innerBlocks": []}]}]}]}